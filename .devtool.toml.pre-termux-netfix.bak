[project]
name = "Telegram-Speed-Hook"
type = "android"
repo = "git@github.com:Mikeyphw/Telegram-Speed-Hook.git"
root = "."
module = "app"

[android]
application_id = "Telegram.Speed.Hook"
namespace = "Telegram.Speed.Hook"
compile_sdk = 34
min_sdk = 21
target_sdk = 34
debug_apk = "app/build/outputs/apk/debug/app-debug.apk"

[xposed]
module_class = "Telegram.Speed.Hook.MainHook"
min_version = 82
log_tag = "TgSpeedHook"

[xposed.scope]
telegram = "org.telegram.messenger"
nullgram = "top.qwq2333.nullgram"

[hook]
target_class = "org.telegram.messenger.FileLoadOperation"
target_method = "updateParams"
big_file_threshold_bytes = 5242880
download_chunk_size_big_bytes = 1048576
max_download_requests_big = 12

[checks.source]
description = "Verify Nullgram support and safer large-file hook logic"
command = """
set -eu

MAIN="app/src/main/java/Telegram/Speed/Hook/MainHook.java"
MANIFEST="app/src/main/AndroidManifest.xml"
GRADLE="app/build.gradle"

grep -q 'top.qwq2333.nullgram' "$MAIN"
grep -q 'org.telegram.messenger.FileLoadOperation' "$MAIN"
grep -q 'updateParams' "$MAIN"

grep -q 'BIG_FILE_SIZE_FROM' "$MAIN"
grep -q 'downloadChunkSizeBig' "$MAIN"
grep -q 'maxDownloadRequestsBig' "$MAIN"
grep -q 'forceSmallChunk' "$MAIN"
grep -q 'isPreloadVideoOperation' "$MAIN"
grep -q 'isStream' "$MAIN"

if grep -q '"maxDownloadRequests"' "$MAIN"; then
  echo "ERROR: normal maxDownloadRequests should not be overridden"
  exit 1
fi

grep -q 'org.telegram.messenger;top.qwq2333.nullgram' "$MANIFEST"
grep -q "compileOnly 'de.robv.android.xposed:api:82'" "$GRADLE"

echo "Source checks passed."
"""

[tasks.clean]
description = "Clean Gradle outputs"
command = "./gradlew clean"

[tasks.build_debug]
description = "Build debug APK"
command = "./gradlew :app:assembleDebug"

[tasks.verify]
description = "Run source checks and build"
command = """
set -eu
devtool run checks.source
./gradlew :app:assembleDebug
"""

[tasks.install_debug]
description = "Install debug APK on connected device"
command = "adb install -r app/build/outputs/apk/debug/app-debug.apk"

[tasks.force_stop_targets]
description = "Force-stop Telegram and Nullgram after enabling LSPosed scope"
command = """
adb shell am force-stop org.telegram.messenger || true
adb shell am force-stop top.qwq2333.nullgram || true
"""

[tasks.logs]
description = "Tail hook logs"
command = "adb logcat -v time | grep TgSpeedHook"

[tasks.release_check]
description = "Full local release sanity check"
command = """
set -eu
devtool run checks.source
./gradlew clean :app:assembleDebug
ls -lh app/build/outputs/apk/debug/app-debug.apk
"""

[artifacts]
debug_apk = "app/build/outputs/apk/debug/app-debug.apk"
source_hook = "app/src/main/java/Telegram/Speed/Hook/MainHook.java"
manifest = "app/src/main/AndroidManifest.xml"


[commands]
build = "./gradlew :app:assembleDebug"
check = "grep -q 'top.qwq2333.nullgram' app/src/main/java/Telegram/Speed/Hook/MainHook.java && ./gradlew :app:assembleDebug"
install = "adb install -r app/build/outputs/apk/debug/app-debug.apk"
logs = "adb logcat -v time | grep TgSpeedHook"
